# ==============================================================================
# PROGRESSIQ — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: SQLite for quick local development
# Cloud Production: Use Supabase / Neon / AWS RDS PostgreSQL (asyncpg driver)
# Example: postgresql+asyncpg://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./progressiq.db

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate a random 32+ character string in production (e.g. openssl rand -hex 32)
JWT_SECRET=progressiq_secure_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ------------------------------------------------------------------------------
# 3. AI & LLM PROVIDER (ZERO-COST READY)
# ------------------------------------------------------------------------------
# Options: 'gemini' | 'mock'
# Free tier: Get a 100% free Gemini API Key at https://aistudio.google.com/
# If left empty, PROGRESSIQ automatically uses built-in Mock AI (zero setup needed)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. UNIFIED FILE STORAGE (EVIDENCE & REPORTS)
# ------------------------------------------------------------------------------
# Options: 'local' | 'supabase' | 's3'
# Default: 'local' (files saved to /uploads directory)
STORAGE_PROVIDER=local

# Supabase Storage (Free 1GB tier)
# https://supabase.com/ -> Project Settings -> API & Storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=progressiq-uploads

# AWS S3 / Cloudflare R2 / MinIO (Optional)
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 5. SERVER SETTINGS
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=False
